# SalesFlow backend environment
# MongoDB 7 replica set (required for transactions/change streams in production).
# Leave empty to use the built-in in-process document store (same API, unique indexes enforced).
MONGO_URI=
MONGO_DB=salesflow

# Redis (queue/pub-sub in production; in-process when empty)
REDIS_URL=

# JWT signing key - change in production
SECRET_KEY=salesflow-dev-secret-change-in-production

# Demo realtime simulator: one event every ~5s (feed-only, occasionally a real lead)
DEMO_REALTIME=1
